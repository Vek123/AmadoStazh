include ~@mixins/productionCard
include ~@mixins/componentHeader

mixin chessesList(className, tag, title, cards)
    .chesses-list(class= className)
        .template-container 
            +componentHeader("chesses-list__header", tag, title)
            .chesses-list__container
                each card in cards
                    +productionCard("chesses-list__card", card.cardImage, card.buttonText, card.title, card.image_id, card.type, card.desc, card.link, card.reverse)(class= card.className)
                