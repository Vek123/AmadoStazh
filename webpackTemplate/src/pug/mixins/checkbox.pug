mixin checkbox(text, inputId, required=false)
    - let requiredClass = ""
    if required 
        - requiredClass = "_req"
    .checkbox
        if required
            input(class= requiredClass type="checkbox" id=inputId checked)
        else 
            input(type="checkbox" id=inputId)
        label.checkbox__label(for=inputId)
            .checkbox__text!= text
