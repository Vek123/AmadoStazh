include ~@mixins/inputText
include ~@mixins/textarea
include ~@mixins/checkbox
include ~@mixins/mainButton
include ~@mixins/squareCloseButton
include ~@mixins/radioButton
include ~@mixins/select

mixin feedbackModal(className, title, subtitle)
    -
        var selectList = [
            {name: "Нулевое", value: "zero", selected: false},
            {name: "Первое", value: "first", selected: false},
            {name: "Второе", value: "second", selected: false},
            {name: "Третье", value: "third", selected: false},
        ]
    .feedback-modal(class=className)
        .feedback-modal__close-button
            +squareCloseButton()
        .form-container
            h2.feedback-modal__title= title
            .feedback-modal__subtitle= subtitle
            .feedback-modal__form
                form.form(action="#" method="POST")
                    .form__item
                        +inputText("", "text", "name", "Введите ваше имя:", "Это поле обязательно для заполнения")
                    .form__item
                        +inputText("", "text", "contacts", "Введите ваш телефон или e-mail:", "Это поле обязательно для заполнения")
                    .form__item
                        +textarea("", "message", "Введите ваше сообщение", "Это поле обязательно для заполнения", 7)
                    .form__item
                        .form__text Выберите одно из двух:
                        .form__radio
                            +radioButton("", "Первая кнопка", "form__radio-first", "choice", "first", false)
                        .form__radio
                            +radioButton("", "Вторая кнопка", "form__radio-second", "choice", "second", false)
                    .form__item
                        +select("", "selected", "selected", selectList, null)
                    .form__item
                        +checkbox("", `Нажимая на кнопку «Отправить», я даю согласие на обработку&nbsp;<a class="intext-link" href="#">персональных данных</a>`, "feedback-modal-form__checkbox", "aggreement", "true", true)
                    .form__button
                        +mainButton("", "Отправить", true, "", true, "submit")