include ~@mixins/inputText
include ~@mixins/textarea
include ~@mixins/checkbox
include ~@mixins/mainButton
include ~@mixins/squareCloseButton
include ~@mixins/radioButton
include ~@mixins/select
include ~@mixins/ratingInput

mixin feedbackModal(className, title, subtitle)
    -
        var selectList = [
            {name: "Первое", value: "Первое", selected: false},
            {name: "Второе", value: "Второе", selected: false},
            {name: "Третье", value: "Третье", selected: false},
            {name: "Четвёртое", value: "Четвёртое", selected: false},
        ]
    .feedback-modal(class=className)
        .modal__close-button.feedback-modal__close-button
            +squareCloseButton()
        .form-container
            h2.feedback-modal__title= title
            .feedback-modal__subtitle= subtitle
            .feedback-modal__form
                form.form(action="#" method="POST")
                    .form__item
                        +inputText("", "text", "name", "Введите ваше имя:", "Это поле обязательно для заполнения и должно состоять минимум из 2 знаков")
                    .form__item
                        +inputText("", "text", "contacts", "Введите ваш телефон или e-mail:", "Это поле обязательно для заполнения и должно содержать корректный номер телефона формата \"+7(123)456-78-90\" или адрес электронной почты")
                    .form__item
                        +textarea("", "message", "Введите ваше сообщение", "Это поле обязательно для заполнения и должно состоять минимум из 5 знаков", 7)
                    .form__item
                        +select("", "select", "selected", selectList, null, false, "Это поле обязательно для заполнения, необходимо выбрать один вариант из приведённого списка")
                    .form__item
                        .form__text Выберите одно из двух:
                        .form__radio
                            +radioButton("", "Первая кнопка", "form__radio-first", "radio", "Первая кнопка", false)
                        .form__radio
                            +radioButton("", "Вторая кнопка", "form__radio-second", "radio", "Вторая кнопка", false)
                    .form__item
                        +ratingInput("", "medRating", "Поставьте Вашу оценку препарату:", "medRating-", 5)
                    .form__item
                        +checkbox("", `Нажимая на кнопку «Отправить», я даю согласие на обработку&nbsp;<a class="intext-link" target="_blank" href="/">персональных данных</a>`, "feedback-modal-form__checkbox", "aggreement", "true", true)
                    .form__button
                        +mainButton("", "Отправить", true, "", true, "submit")