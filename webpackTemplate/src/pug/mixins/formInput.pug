mixin formInput(placeholder, type, classNames, name, required="false")
    - let requiredClass = ""
    - let classes = []
    if required 
        - requiredClass = "_req"
    -
        for (let i = 0; i < classNames.length; i++) {
            classes.push("form-input__" + classNames[i]);
        }
    .input-text.form-input
        if type === "textarea"
            textarea.input-text__input.form-input__input(class=classes, class=requiredClass, name=name placeholder=" " rows="7")
        else
            input.input-text__input.form-input__input(class=classes, class=requiredClass, type=type, name=name placeholder=" ")
        span.form-input__placeholder= placeholder