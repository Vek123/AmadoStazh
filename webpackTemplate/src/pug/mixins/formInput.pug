mixin formInput(placeholder, types, name, required="false")
    - let requiredClass = ""
    - let typesClasses = []
    if required 
        - requiredClass = "_req"
    -
        for (let i = 0; i < types.length; i++) {
            typesClasses.push("form-input__" + types[i]);
        }
    .form-input
        if types[0] === "textarea"
            textarea.form-input__input(class=typesClasses, class=requiredClass, name=name placeholder=" " rows="7")
        else
            input.form-input__input(class=typesClasses, class=requiredClass, type=text name=name placeholder=" ")
        span.form-input__placeholder= placeholder