mixin formInput(placeholder, type, name, required="false")
    - let requiredClass = ""
    if required 
        - requiredClass = "_req"
    .form-input
        if type === "textarea"
            textarea.form-input__input(class="form-input__" + type, class=requiredClass, name=name placeholder=" " rows="7")
        else
            input.form-input__input(class="form-input__" + type, class=requiredClass, type=text name=name placeholder=" ")
        span.form-input__placeholder= placeholder