mixin mainButton(className, text= 'Кнопка', invert= false, link='/', button=false, type="button")
    - var classList = ['main-button']
    if invert 
        - classList.push('main-button--inverted')
    if button
        button(class= classList, class= className, type=type)= text
    else
        a(class= classList, class= className, href= link)= text