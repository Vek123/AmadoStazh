mixin ratingInput(className, name, text, prefixId, defaultValue=0)
    .rating-input(class=className)
        .rating-input__text= text
        .rating-input__rating
            - for(let i = 5; i > 0; i--)
                if defaultValue === i
                    input.rating-input__input(type="radio" name=name value=i id=prefixId + "star-" + i checked)
                else
                    input.rating-input__input(type="radio" name=name value=i id=prefixId + "star-" + i)
                label.rating-input__label(for=prefixId + "star-" + i)