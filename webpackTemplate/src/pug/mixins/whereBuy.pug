include ~@mixins/componentHeader

mixin whereBuy(className, tag, title, cards)
    .where-buy(class= className)
        .template-container
            .where-buy__content
                +componentHeader("where-buy__header", tag, title)
                .where-buy__items
                    each card in cards
                        .where-buy__item-container
                            a.where-buy__pharmacy
                                img.where-buy__logo(src= card.image)
                                .where-buy__domain= card.domain