mixin advantage(className, color, title, desc)
    case color 
        when "red"
            .advantage.advantage--red(class= className)
                .advantage__background
                    .advantage__background-light
                        include ~@images/advantageImages/red/background.svg
                    .advantage__background-image
                        img(src="./images/advantageImages/red/content.png")
                .advantage__title= title
                .advantage__desc= desc
        when "biruse"
            .advantage.advantage--biruse(class= className)
                .advantage__background
                    .advantage__background-light
                        include ~@images/advantageImages/biruse/background.svg
                    .advantage__background-image
                        img(src="./images/advantageImages/biruse/content.png")
                .advantage__title= title
                .advantage__desc= desc
        when "blue"
            .advantage.advantage--blue(class= className)
                .advantage__background
                    .advantage__background-light
                        include ~@images/advantageImages/blue/background.svg
                    .advantage__background-image
                        img(src="./images/advantageImages/blue/content.png")
                .advantage__title= title
                .advantage__desc= desc
        when "yellow"
            .advantage.advantage--yellow(class= className)
                .advantage__background
                    .advantage__background-light
                        include ~@images/advantageImages/yellow/background.svg
                    .advantage__background-image
                        img(src="./images/advantageImages/yellow/content.png")
                .advantage__title= title
                .advantage__desc= desc
        when "pink"
            .advantage.advantage--pink(class= className)
                .advantage__background
                    .advantage__background-light
                        include ~@images/advantageImages/pink/background.svg
                    .advantage__background-image
                        img(src="./images/advantageImages/pink/content.png")
                .advantage__title= title
                .advantage__desc= desc
        when "green"
            .advantage.advantage--green(class= className)
                .advantage__background
                    .advantage__background-light
                        include ~@images/advantageImages/green/background.svg
                    .advantage__background-image
                        img(src="./images/advantageImages/green/content.png")
                .advantage__title= title
                .advantage__desc= desc
