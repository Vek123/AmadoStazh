mixin select(className, name, inputId, list, defaultId=null, required=false, errorMessage="Это поле обязательно для заполнения", defaultName="Выберите значение:")
    .select(class=className)
        .select__output(class= (defaultId !== null ? "" : "select__output--default"))
            input.select__input(type="radio" id=inputId name=name value= (defaultId !== null ? list[defaultId].value : "none") data-default-value="none" data-default-id=defaultId  checked)
            label.select__label(for=inputId)= defaultId !== null ? list[defaultId].name : defaultName
            span.select__icon: include ~@icons/buttons/arrow-angle-down-big.svg
            span.select__error-icon: include ~@images/close-small-red.svg
            span.select__error-message= errorMessage
        .select__list-container
            ul.select__list
                if !required 
                    li.select__item(class= (defaultId !== null ? "" : "select__item--selected") data-value= "none" data-name= defaultName) -----
                each item in list
                    li.select__item(class= item.selected ? "select__item--selected" : "" data-value= item.value data-name= item.name)= item.name
