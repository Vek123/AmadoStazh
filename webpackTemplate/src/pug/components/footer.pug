include ~@mixins/inTextLink
include ~@mixins/whereBuy

-
    var pharmacyCards = [
        {image: "./images/whereBuy/stolichki.svg", domain: "stolichki.ru"},
        {image: "./images/whereBuy/neopharm.svg", domain: "neopharm.ru"},
    ]

footer.footer
    .footer__background-block
    .footer__where-buy
        +whereBuy("", "Где купить", "Спрашивайте продукты Импловит в аптеках", pharmacyCards)
    .footer-top
        .template-container 
            .footer-top__container 
                .footer-top__logo: a(href="/ui.html"): include ~@images/footer/logo.svg
                ul.footer-list
                    li.footer-list__item 
                        ul 
                            li: +inTextLink("", "Каталог товаров", true, "/ui.html")
                            li: +inTextLink("", "О компании", true, "/ui.html")
                            li: +inTextLink("", "Наши бренды", true, "/ui.html")
                            li: +inTextLink("", "Акции", true, "/ui.html")
                    li.footer-list__item 
                        ul
                            li: +inTextLink("", "Азбука здоровья", true, "/ui.html")
                            li: +inTextLink("", "Статьи", true, "/ui.html")
                            li: +inTextLink("", "Где купить", true, "/ui.html")
                            li: +inTextLink("", "Контакты", true, "/ui.html")
                .requisites 
                    ul 
                        li ООО «НЕО-ФАРМ»
                        li 117246, Россия, г. Москва, ул. Обручева, д. 55А
                        li: +inTextLink("", "+7 (499) 648 - 37 - 27", true, "tel:+74996483727")
                        li: br
                        li: +inTextLink("", "customer@implovit.ru", true, "mailto:customer@implovit.ru")
    .footer-bottom
        .template-container 
            .amado-brand: a(href="https://amado-id.ru/" target="_blank"): include ~@images/amado-brand.svg
        .template-container.footer-bottom__container
            .footer-bottom__attention
                picture 
                    source(srcset="./images/footer/text-attention-799.png" media="(max-width: 779px)")
                    source(srcset="./images/footer/text-attention-1023.png" media="(max-width: 1023px)")
                    source(srcset="./images/footer/text-attention-1279.png" media="(max-width: 1279px)")
                    source(srcset="./images/footer/text-attention-1599.png" media="(max-width: 1599px)")
                    source(srcset="./images/footer/text-attention-1799.png" media="(max-width: 1799px)")
                    img(src="./images/footer/text-attention.png")
